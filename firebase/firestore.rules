rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isNonEmptyString(v) {
      return v is string && v.size() > 0 && v.size() < 200;
    }

    function validVehicleType() {
      return request.resource.data.vehicleType in
        ['saloon', 'suv', 'pickup', 'van', 'truck', 'motorcycle', 'other'];
    }

    match /services/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    match /membershipPlans/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    match /washBays/{id} {
      allow read, write: if false;
    }

    match /customers/{id} {
      allow create: if isNonEmptyString(request.resource.data.fullName)
                    && isNonEmptyString(request.resource.data.phone)
                    && request.resource.data.phone.size() < 30;
      allow read, update, delete: if false;
    }

    match /vehicles/{id} {
      allow create: if isNonEmptyString(request.resource.data.registrationNo)
                    && isNonEmptyString(request.resource.data.customerId)
                    && validVehicleType();
      allow read, update, delete: if false;
    }

    match /bookings/{id} {
      allow create: if isNonEmptyString(request.resource.data.bookingNumber)
                    && isNonEmptyString(request.resource.data.customerId)
                    && isNonEmptyString(request.resource.data.vehicleId)
                    && isNonEmptyString(request.resource.data.serviceId)
                    && isNonEmptyString(request.resource.data.scheduledDate)
                    && isNonEmptyString(request.resource.data.scheduledTime)
                    && request.resource.data.status == 'requested'
                    && request.resource.data.paymentStatus == 'unpaid'
                    && request.resource.data.quotedAmountUgx is number
                    && request.resource.data.quotedAmountUgx >= 0;
      allow read, update, delete: if false;
    }

    match /bookingStatusHistory/{id} {
      allow create: if isNonEmptyString(request.resource.data.bookingId)
                    && request.resource.data.newStatus == 'requested';
      allow read, update, delete: if false;
    }

    match /payments/{id} { allow read, write: if false; }
    match /loyaltyAccounts/{id} { allow read, write: if false; }
    match /loyaltyTransactions/{id} { allow read, write: if false; }
    match /auditLogs/{id} { allow read, write: if false; }
    match /profiles/{id} { allow read, write: if false; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
