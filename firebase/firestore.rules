rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public catalogue — read-only for everyone
    match /services/{id} {
      allow read: if resource.data.active == true;
      allow write: if false; // seed via Admin / console only
    }
    match /membershipPlans/{id} {
      allow read: if resource.data.active == true;
      allow write: if false;
    }
    match /washBays/{id} {
      allow read: if false; // staff only later
      allow write: if false;
    }

    // Operational data — no direct public writes
    match /customers/{id} {
      allow read, write: if false;
    }
    match /vehicles/{id} {
      allow read, write: if false;
    }
    match /bookings/{id} {
      allow read, write: if false;
    }
    match /bookingStatusHistory/{id} {
      allow read, write: if false;
    }
    match /payments/{id} {
      allow read, write: if false;
    }
    match /loyaltyAccounts/{id} {
      allow read, write: if false;
    }
    match /loyaltyTransactions/{id} {
      allow read, write: if false;
    }
    match /auditLogs/{id} {
      allow read, write: if false;
    }
    match /profiles/{id} {
      allow read, write: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
